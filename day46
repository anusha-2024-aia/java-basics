import java.util.Arrays;

class Solution {
    public boolean checkInclusion(String s1, String s2) {

        int[] s1Count = new int[26];
        int[] windowCount = new int[26];

        // Frequency of s1
        for (int i = 0; i < s1.length(); i++) {
            s1Count[s1.charAt(i) - 'a']++;
        }

        int left = 0;
        int k = s1.length();

        // Sliding window on s2
        for (int right = 0; right < s2.length(); right++) {

            // Add right character
            windowCount[s2.charAt(right) - 'a']++;

            // Window reaches size k
            if (right - left + 1 == k) {

                // Check permutation
                if (Arrays.equals(s1Count, windowCount)) {
                    return true;
                }

                // Remove left character
                windowCount[s2.charAt(left) - 'a']--;
                left++;
            }
        }

        return false;
    }
}


import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> res = new ArrayList<>();
        int n = s.length();
        int k = p.length();
        
        // Edge case: if p is longer than s, p's anagrams cannot exist in s
        if (n < k) {
            return res;
        }
        
        int[] pCount = new int[26];
        int[] sCount = new int[26];
        
        // Build the frequency count for p and the first window of s
        for (int i = 0; i < k; i++) {
            pCount[p.charAt(i) - 'a']++;
            sCount[s.charAt(i) - 'a']++;
        }
        
        // Check the very first window
        if (Arrays.equals(pCount, sCount)) {
            res.add(0);
        }
        
        // Slide the window across the rest of string s
        for (int i = k; i < n; i++) {
            // Add the newly entered character on the right
            sCount[s.charAt(i) - 'a']++;
            // Remove the character that just left the window on the left
            sCount[s.charAt(i - k) - 'a']--;
            
            // Compare the frequency arrays
            if (Arrays.equals(pCount, sCount)) {
                res.add(i - k + 1);
            }
        }
        
        return res;
    }
}
class Solution {
    public int characterReplacement(String s, int k) {
        int[] count = new int[26];
        int left = 0;
        int maxLength = 0;
        int maxFrequency = 0;
        for(int right = 0; right < s.length(); right++){
            count[s.charAt(right) - 'A']++;
            maxFrequency = Math.max(
                maxFrequency,
                count[s.charAt(right) - 'A']
            );
            while(right - left + 1 - maxFrequency > k){
                count[s.charAt(left) - 'A']--;
                left++;
            }
            maxLength = Math.max(
                maxLength,
                right - left + 1
            );
        }
        return maxLength;
        
    }
}