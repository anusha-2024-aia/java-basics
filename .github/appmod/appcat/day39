class Solution {
    public boolean validMountainArray(int[] arr) {

        // A mountain must have at least 3 elements
        if (arr.length < 3) {
            return false;
        }

        int i = 0;

        // Increasing part
        for (; i < arr.length - 1; i++) {

            if (arr[i] > arr[i + 1]) {
                i++;
                break;
            }

            else if (arr[i] == arr[i + 1]) {
                return false;
            }
        }

        // Decreasing part
        for (; i < arr.length; i++) {

            if (arr[i - 1] <= arr[i]) {
                return false;
            }
        }

        return true;
    }
}

