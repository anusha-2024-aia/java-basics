import java.util.Scanner;
import java.util.ArrayList;

public class SimpleTaskManager {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        ArrayList<String> tasks = new ArrayList<>();
        System.out.println("--- Task Manager ---");
        while (true) {
            System.out.print("1.Add 2.View 3.Exit: ");
            int choice = scanner.nextInt();
            scanner.nextLine(); 
            if (choice == 1) {
                System.out.print("Enter task: ");
                tasks.add(scanner.nextLine());
                System.out.println("Task added.");
            } else if (choice == 2) {
                System.out.println("\nYour Tasks:");
                for (int i = 0; i < tasks.size(); i++) {
                    System.out.println((i + 1) + ". " + tasks.get(i));
                }
            } else if (choice == 3) {
                System.out.println("Goodbye!");
                break;
            } else {
                System.out.println("Invalid option.");
            }
        }
        scanner.close();
    }
}

class Solution {
    public int trap(int[] height) {

        int left = 0;
        int right = height.length - 1;

        int leftMax = 0;
        int rightMax = 0;

        int water = 0;

        while (left <= right) {

            if (height[left] <= height[right]) {

                if (height[left] >= leftMax) {

                    leftMax = height[left];

                } else {

                    water += leftMax - height[left];
                }

                left++;

            } else {

                if (height[right] >= rightMax) {

                    rightMax = height[right];

                } else {

                    water += rightMax - height[right];
                }

                right--;
            }
        }
        return water;
    }
    
};


class Solution {
    public int searchInsert(int[] nums, int target) {
        for (int i = 0; i < nums.length; i++) {
            // If we find the target OR a number larger than the target,
            // 'i' is the exact spot where our target belongs!
            if (nums[i] >= target) {
                return i; 
            }
        }
        // If the target is larger than every number in the array,
        // it belongs at the very end.
        return nums.length;
    }
}


class Solution {
    public void sortColors(int[] nums) {
        int low = 0;
        int mid = 0;
        int high = nums.length-1;
        while(mid <= high){
            if(nums[mid] == 0){
                int temp = nums[low];
                nums[low] = nums[mid];
                nums[mid] = temp;
                low++;
                mid++;

            } else if(nums[mid] == 1){
                mid++;
            } else{
                int temp = nums[mid];
                nums[mid] = nums[high];
                nums[high] = temp;

                high--;
            }
            
        } 

        
    }
}