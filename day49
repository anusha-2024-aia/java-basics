class Solution {
    ArrayList<Integer> countDistinct(int arr[], int k) {
        // code here
        ArrayList<Integer> res = new ArrayList<>();
        int left = 0;
       
        int[] frequency = new int[100001];
        int distinct = 0;
       for(int right= 0; right < arr.length; right++){
           frequency[arr[right]]++;
       
           if(frequency[arr[right]] == 1){
              distinct++;
           }
           
            
            if((right - left + 1) == k){
                res.add(distinct);
            
                frequency[arr[left]]--;
                if(frequency[arr[left]] == 0){
                   distinct--;
                }
                left++;
            }
       }
       return res;
    }
}



class Solution {
    public ArrayList<Integer> maxOfSubarrays(int[] arr, int k) {

        ArrayList<Integer> res = new ArrayList<>();
        Deque<Integer> deque = new LinkedList<>();

        int left = 0;

        for (int right = 0; right < arr.length; right++) {

            // 1. Remove smaller elements from the back
            while (!deque.isEmpty() && arr[deque.peekLast()] <= arr[right]) {
                deque.pollLast();
            }

            // 2. Add current index
            deque.addLast(right);

            // 3. Remove element which is outside the window
            if (deque.peekFirst() < left) {
                deque.pollFirst();
            }

            // 4. Window size == K
            if (right - left + 1 == k) {

                // Front contains the maximum
                res.add(arr[deque.peekFirst()]);

                // Move window
                left++;
            }
        }

        return res;
    }
}


class Solution {
    public ArrayList<Integer> maxOfSubarrays(int[] arr, int k) {

        ArrayList<Integer> res = new ArrayList<>();
        Deque<Integer> deque = new LinkedList<>();

        int left = 0;

        for (int right = 0; right < arr.length; right++) {

            // Add current element
            while (!deque.isEmpty() && arr[deque.peekLast()] <= arr[right]) {
                deque.pollLast();
            }
            deque.addLast(right);

            // Window size becomes K
            if (right - left + 1 == k) {

                // First element in deque is maximum
                res.add(arr[deque.peekFirst()]);

                // Remove left element if it is in deque
                if (!deque.isEmpty() && deque.peekFirst() == left) {
                    deque.pollFirst();
                }

                // Move window
                left++;
            }
        }

        return res;
    }
}