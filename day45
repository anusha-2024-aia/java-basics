import json
import time
from datetime import datetime

class ProductivityApp:
    def __init__(self):
        self.tasks = []
        self.expenses = []

    def add_task(self, title):
        self.tasks.append({"title": title, "done": False, "date": str(datetime.now().date())})
        print(f" Task '{title}' added successfully.")

    def list_tasks(self):
        if not self.tasks:
            print("No tasks found.")
            return
        for i, task in enumerate(self.tasks, 1):
            status = "✅" if task["done"] else "❌"
            print(f"{i}. [{status}] {task['title']} ({task['date']})")

    def complete_task(self, index):
        if 0 <= index < len(self.tasks):
            self.tasks[index]["done"] = True
            print(f" Marked task #{index + 1} as complete!")
        else:
            print("Invalid task number.")

    def add_expense(self, desc, amount):
        try:
            self.expenses.append({"desc": desc, "amount": float(amount)})
            print(f" Added expense: {desc} (${float(amount):.2f})")
        except ValueError:
            print("Error: Amount must be a valid number.")

    def view_expenses(self):
        if not self.expenses:
            print("No expenses tracked yet.")
            return
        total = sum(e["amount"] for e in self.expenses)
        for e in self.expenses:
            print(f"- {e['desc']}: ${e['amount']:.2f}")
        print(f"Total Spend: ${total:.2f}")

    def run_pomodoro(self, minutes=25):
        print(f"⏱️ Pomodoro started for {minutes} minutes. Stay focused!")
        try:
            seconds = minutes * 60
            for i in range(seconds, 0, -1):
                mins, secs = divmod(i, 60)
                print(f"Time remaining: {mins:02d}:{secs:02d}", end="\r")
                time.sleep(1)
            print("\n⏰ Time's up! Take a short break.")
        except KeyboardInterrupt:
            print("\n⏹️ Timer paused.")

def main():
    app = ProductivityApp()
    while True:
        print("\n=== 100-LINE PRODUCTIVITY SUITE ===")
        print("1. Add Task      2. List Tasks     3. Complete Task")
        print("4. Add Expense   5. View Expenses  6. Pomodoro Timer")
        print("7. Exit")
        choice = input("Select an option (1-7): ").strip()
        
        if choice == "1":
            title = input("Enter task title: ")
            app.add_task(title)
        elif choice == "2":
            app.list_tasks()
        elif choice == "3":
            app.list_tasks()
            try:
                idx = int(input("Enter task number to complete: ")) - 1
                app.complete_task(idx)
            except ValueError:
                print("Please enter a valid integer.")
        elif choice == "4":
            desc = input("Enter expense description: ")
            amt = input("Enter expense amount: $")
            app.add_expense(desc, amt)
        elif choice == "5":
            app.view_expenses()
        elif choice == "6":
            try:
                mins = input("Enter timer duration in minutes (default 25): ")
                mins = int(mins) if mins.strip() else 25
                app.run_pomodoro(mins)
            except ValueError:
                print("Invalid duration.")
        elif choice == "7":
            print("Goodbye! Stay productive.")
            break
        else:
            print("Invalid option. Please choose between 1 and 7.")

if __name__ == "__main__":
    main()
