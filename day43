import java.util.ArrayList;
import java.util.List;

class Asset {
    private String title;
    public Asset(String title) {
        this.title = title;
    }
    public String getTitle() {
        return title;
    }
}

class Book extends Asset {
    private String writer;
    public Book(String title, String writer) {
        super(title);
        this.writer = writer;
    }
    public String getWriter() {
        return writer;
    }
}

public class LibraryManager {
    public static void main(String[] args) {
        List<Book> shelf = new ArrayList<>();
        shelf.add(new Book("The Hobbit", "J.R.R. Tolkien"));
        shelf.add(new Book("1984", "George Orwell"));
        shelf.add(new Book("Dracula", "Bram Stoker"));
        System.out.println("--- Library Catalog ---");
        int count = 0;
        for (Book book : shelf) {
            count++;
            System.out.print("Item " + count + ": ");
            if (book.getTitle().equals("1984")) {
                System.out.println("[RESERVED] " + book.getTitle());
            } else {
                System.out.println(book.getTitle() + " by " + book.getWriter());
            }
        }
        System.out.println("Total active items: " + count);
    }
}


import java.util.Arrays;
import java.util.List;

interface Discount {
    double apply(double price);
}

class Product {
    private String name;
    private double cost;
    public Product(String name, double cost) {
        this.name = name;
        this.cost = cost;
    }
    public String getName() {
        return name;
    }
    public double getCost() {
        return cost;
    }
}

public class OrderProcessor {
    public static void main(String[] args) {
        List<Product> cart = Arrays.asList(
            new Product("Laptop", 1200.0),
            new Product("Mouse", 25.0),
            new Product("Keyboard", 80.0),
            new Product("Monitor", 300.0)
        );
        Discount promo = price -> price * 0.90;
        System.out.println("Processing eligible items over $50...");
        double grandTotal = cart.stream()
            .filter(item -> item.getCost() > 50.0)
            .mapToDouble(item -> {
                double salePrice = promo.apply(item.getCost());
                System.out.printf("- %s: Regular $%.2f -> Sale $%.2f%n", 
                    item.getName(), item.getCost(), salePrice);
                return salePrice;
            })
            .sum();
        System.out.printf("Final Order Total: $%.2f%n", grandTotal);
    }
}

import java.util.Random;
import java.util.Scanner;

public class NumberGame {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();
        
        int targetNumber = random.nextInt(100) + 1;
        int totalAttempts = 0;
        boolean hasGuessedCorrectly = false;
        
        System.out.println("Welcome to the Number Guessing Game!");
        System.out.println("I have chosen a number between 1 and 100.");
        
        while (!hasGuessedCorrectly) {
            System.out.print("Enter your guess: ");
            
            if (!scanner.hasNextInt()) {
                System.out.println("Please enter a valid number!");
                scanner.next();
                continue;
            }
            
            int playerGuess = scanner.nextInt();
            totalAttempts++;
            
            if (playerGuess < 1 || playerGuess > 100) {
                System.out.println("Keep it between 1 and 100.");
            } else if (playerGuess < targetNumber) {
                System.out.println("Too low! Try a higher number.");
            } else if (playerGuess > targetNumber) {
                System.out.println("Too high! Try a lower number.");
            } else {
                hasGuessedCorrectly = true;
                System.out.println("Congratulations!");
                System.out.println("You found it in " + totalAttempts + " tries.");
            }
        }
        
        scanner.close();
        System.out.println("Thanks for playing!");
    }
}


